{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dockercrm:frontend",
      "url": "http://localhost:3000",
      "request": "launch",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMapPathOverrides": {
        "/app/*": "${webRoot}/*"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "remoteRoot": "/app",
      "localRoot": "${workspaceFolder}/bankServer",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "name": "vscode-jest-tests",
      "request": "launch",
      "program": "${workspaceFolder}/bankServer/node_modules/jest/bin/jest",
      "args": [
        "--runInBand"
        // "test/stable_tests/passwordRecovery.test.ts",
        // "-t",
        // "\"showing error on uncorrect fill fields phone\""
      ],
      "cwd": "${workspaceFolder}/bankServer",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "disableOptimisticBPs": true
    }
  ]
}
