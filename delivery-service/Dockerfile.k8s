# Учебный образ: один build stage, отдельный процесс сервиса в каждом Pod.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app
ENV NX_DAEMON=false
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npx nx run-many -t build -p api account banner event payment --parallel=2

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist/apps ./dist/apps
RUN mkdir -p uploads && chown node:node uploads
USER node
# Deployment переопределяет args для нужного сервиса; shell и PM2 не нужны.
ENTRYPOINT ["node"]
CMD ["dist/apps/api/main.js"]
